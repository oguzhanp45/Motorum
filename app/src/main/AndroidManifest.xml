<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13'ten beri bildirim gostermek calisma zamani izni istiyor.
         Alarm icin ayrica izin yok: kesin olmayan alarm kullaniyoruz, yani
         sistemden pil yonetimini devralmiyoruz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hava durumu icin konum. Ikisi birlikte tanimlanmak zorunda: FINE tek
         basina istenirse Android 12'den beri sistem istegi yok sayiyor.
         Kullanici "Yaklasik" secerse sadece COARSE geliyor, o da bize yetiyor. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MotorumUygulamasi"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Motorum">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Motorum.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarm caldiginda sistem bunu uyandiriyor. exported="false":
             disaridan tetiklenemiyor. Niyeti dogrudan bu sinifa yonlendirdigimiz
             icin intent-filter'a da gerek yok. -->
        <receiver
            android:name=".data.HatirlatmaAlicisi"
            android:exported="false" />

        <!-- Kamera uygulamasi ayri bir uygulama. Ona file:// yolu uzatmak
             Android 7'den beri yasak; FileProvider kendi dosyamiz icin
             content:// adresi uretip sadece o dosya icin gecici izin veriyor.
             exported="false": saglayici disariya kapali. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>
    </application>

</manifest>