<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pencere zemini: Compose ilk kareyi cizmeden once bir an gorunen yuzey.
         Karanlik temada beyaz parlamasin diye values-night'ta koyu tonu var. -->
    <!-- Ust tema AppCompat: MainActivity AppCompatActivity'den turuyor (uygulama
         dili ozelligi icin) ve AppCompat temasi olmadan calismiyor. Gorunum
         degismiyor, ekranlarin tamami Compose. -->
    <style name="Theme.Motorum" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pencere_zemini</item>
    </style>

    <!-- installSplashScreen() calissin diye zorunlu. postSplashScreenTheme splash
         bitince donulecek temayi soyluyor. Zemin ve ikon, Compose'daki acilis
         ekraninin ilk karesiyle birebir ayni (murekkep zemin, beyaz M). -->
    <style name="Theme.Motorum.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/acilis_zemini</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/acilis_isareti</item>
        <item name="postSplashScreenTheme">@style/Theme.Motorum</item>
    </style>
</resources>
